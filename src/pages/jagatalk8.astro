---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "JAGATALK #8 — Roadmap Sekolah Anda ke Program Internasional";
const pageDesc = "Sesi eksklusif untuk kepala sekolah, founder & yayasan. Roadmap praktis naik kelas ke program internasional bersama Dedi Gunawan — pemilik 6 sekolah IDN.";
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical="https://jagatrip.com/jagatalk8"
  ogImage="/images/jagatalk/flyer-jw8.avif"
  ogType="website"
>
  <main id="main" class="jagatalk8-page">

    <!-- ============ URGENCY BAR ============ -->
    <div class="urgency-bar">
      <div class="container">
        <span class="dot"></span> Slot Premium tinggal <strong>terbatas</strong> — pendaftaran ditutup H-3 sebelum acara
      </div>
    </div>

    <!-- ============ STICKY HEADER ============ -->
    <header class="sticky-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="JAGATALK — kembali ke Beranda">
          <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="brand-icon" aria-hidden="true">
            <path d="M50 5 C30 5, 15 10, 12 25 L12 55 C12 78, 30 92, 50 95 C70 92, 88 78, 88 55 L88 25 C85 10, 70 5, 50 5 Z" fill="none" stroke="#0E7C86" stroke-width="6" stroke-linejoin="round"/>
            <rect x="30" y="34" width="40" height="26" rx="7" fill="#FF6B1A"/>
            <path d="M36 60 L32 70 L46 60 Z" fill="#FF6B1A"/>
            <circle cx="42" cy="47" r="2.5" fill="white"/>
            <circle cx="50" cy="47" r="2.5" fill="white"/>
            <circle cx="58" cy="47" r="2.5" fill="white"/>
          </svg>
          <span class="brand-text">
            <span class="c1">jaga</span><span class="c2">talk</span>
            <span class="badge-series">#8</span>
          </span>
        </a>

        <nav class="nav-links">
          <a href="#flyer-section">Flyer</a>
          <a href="#materi">Materi</a>
          <a href="#fasilitas">Fasilitas</a>
          <a href="#pemateri">Pemateri</a>
          <a href="#pricing">Pilihan Tier</a>
          <a href="#faq">FAQ</a>
          <a href="#form" class="header-cta">Daftar Sekarang</a>
        </nav>
      </div>
    </header>

    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="container hero-inner">
        
        <!-- Left Column: Copywriting & CTA -->
        <div class="hero-content">
          <div class="hero-badge">
            <span class="icon-dot"></span> JAGATALK #8 · Webinar Eksklusif Pemilik Sekolah
          </div>
          
          <h1 class="hero-title">
            Roadmap Sekolah Anda ke <span class="accent">Program Internasional.</span>
          </h1>

          <p class="hero-subtitle">
            Dari yang sudah membangunnya 6 kali.
          </p>

          <p class="hero-sub">
            Malam khusus untuk kepala sekolah, founder &amp; yayasan yang siap berhenti bertanya <em>"mulai dari mana"</em> — dan mulai bergerak dengan roadmap yang jelas, praktis, dan teruji.
          </p>

          <div class="hero-meta">
            <span>🗓️ Kamis, 18 September 2026</span>
            <span>⏰ 19.30 WIB · via Zoom</span>
            <span>👨‍🏫 Bersama Dedi Gunawan</span>
          </div>

          <div class="hero-cta-wrap">
            <a href="#form" class="hero-cta">Amankan Kursi Anda <span class="arrow">→</span></a>
            <div class="hero-microcopy">Investasi mulai Rp 99K · Kuota peserta terbatas</div>
          </div>
        </div>

        <!-- Right Column: Flyer Visual Showcase -->
        <div class="hero-visual" id="flyer-section">
          <div class="flyer-card" id="open-flyer-btn" title="Klik untuk memperbesar flyer">
            <div class="flyer-badge">📄 Official Flyer JAGATALK #8</div>
            <img 
              src="/images/jagatalk/flyer-jw8.avif" 
              alt="Flyer Resmi JAGATALK #8 — Roadmap Sekolah Anda ke Program Internasional" 
              width="600" 
              height="800" 
              class="flyer-img"
              loading="eager"
            />
            <div class="flyer-hint">🔍 Klik gambar untuk memperbesar</div>
          </div>
        </div>

      </div>
    </section>

    <!-- ============ FLYER LIGHTBOX MODAL ============ -->
    <div class="flyer-modal" id="flyer-modal" aria-hidden="true">
      <div class="flyer-modal-backdrop" id="close-modal-backdrop"></div>
      <div class="flyer-modal-content">
        <button class="flyer-modal-close" id="close-modal-btn" aria-label="Tutup Flyer">✕</button>
        <img 
          src="/images/jagatalk/flyer-jw8.avif" 
          alt="Flyer Resmi JAGATALK #8 Full Screen" 
          class="flyer-modal-img"
        />
      </div>
    </div>

    <!-- ============ PAIN SECTION ============ -->
    <section class="pain-section">
      <div class="container">
        <div class="pain-quote-wrap">
          <span class="eyebrow">Untuk Anda yang Merasakan Ini</span>
          <p class="pain-quote">
            "Anda sudah <em>mengelola</em> sekolah bertahun-tahun. Tapi tiap PPDB, hati tetap berdegup — takut angkanya tidak sesuai target lagi."
          </p>
        </div>

        <div class="pain-checklist">
          <h3>Kalau Anda mencentang minimal 3 dari 5 ini, sesi ini untuk Anda:</h3>
          <ul>
            <li>Yayasan atau owner mulai bertanya <strong>"kapan sekolah kita bisa naik kelas ke level internasional?"</strong> — dan Anda belum punya jawaban yang meyakinkan.</li>
            <li>Kompetitor sekolah baru hadir dengan positioning <strong>"bilingual"</strong>, <strong>"international curriculum"</strong>, atau <strong>"partner dengan sekolah luar negeri"</strong> — sementara Anda masih bermain di ranah SPP.</li>
            <li>Anda sudah membaca artikel, ikut seminar, bahkan mempertimbangkan konsultan pendidikan — tapi <strong>semua terasa terlalu teoritis</strong> atau terlalu mahal.</li>
            <li>Anda tahu sekolah butuh perubahan — tapi bingung <strong>apa dulu yang harus dibenahi</strong>: SDM guru, kurikulum, branding, atau infrastruktur?</li>
            <li>Anda ingin sekolah punya <strong>MoU aktif dengan kampus atau sekolah luar negeri</strong>, tapi tidak tahu bagaimana cara membuka pintu itu secara kredibel.</li>
          </ul>
        </div>

        <p class="pain-closer">Kalau Anda pernah memikirkan salah satu dari hal di atas — <strong>Anda tidak sendirian.</strong></p>
      </div>
    </section>

    <!-- ============ VALUE SECTION ============ -->
    <section class="value-section" id="materi">
      <div class="container">
        <div class="value-header">
          <span class="eyebrow">Yang Anda Bawa Pulang</span>
          <h2 class="section-title">4 Hal yang <em>Langsung Bisa Diterapkan</em><br>Setelah Menutup Zoom.</h2>
          <p class="section-lead">Bukan teori. Bukan janji. Ini kerangka nyata yang sudah teruji di 6 sekolah IDN — dan siap diadopsi ke sekolah Anda mulai minggu depan.</p>
        </div>

        <div class="value-grid">
          <div class="value-card">
            <div class="value-icon">◈</div>
            <h3>1. Assessment Diri</h3>
            <p>Cara mengukur posisi sekolah Anda di 4 dimensi krusial: SDM, Akademik, Finansial, &amp; Operasional. Jadi Anda tahu <em>di mana harus mulai</em>.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">◆</div>
            <h3>2. Fondasi Naik Kelas</h3>
            <p>Prasyarat konkret sebelum sekolah bisa dilirik mitra internasional: standar akreditasi, guru bilingual, kurikulum bridge, dan sistem manajemen.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">◉</div>
            <h3>3. Cara Membuka Partnership</h3>
            <p>Langkah nyata pendekatan ke sekolah/kampus luar negeri. Kriteria memilih partner, tahapan approach, sampai dokumen MoU yang perlu disiapkan.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">✦</div>
            <h3>4. Launch ke Market</h3>
            <p>Bagaimana memposisikan program "baru" Anda ke calon orang tua murid — agar narasi PPDB tahun depan bercerita berbeda dari tahun ini.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FASILITAS ============ -->
    <section class="fasilitas-section" id="fasilitas">
      <div class="container">
        <div class="fasilitas-card">
          <div class="fasilitas-header">
            <span class="eyebrow">Fasilitas Peserta</span>
            <h2>Lebih dari Sekadar Menonton Webinar</h2>
            <p>Setiap peserta — Regular maupun Premium — mendapatkan paket fasilitas lengkap berikut:</p>
          </div>

          <ul class="fasilitas-list">
            <li>
              <span class="fasilitas-check">✓</span>
              <div>
                <strong>Live Session Bersama Dedi Gunawan</strong>
                <span>Sesi interaktif langsung dengan pemilik 6 sekolah IDN.</span>
              </div>
            </li>
            <li>
              <span class="fasilitas-check">✓</span>
              <div>
                <strong>Rekaman Video Full Sesi</strong>
                <span>Akses 3 bulan — bisa Anda tonton ulang atau share ke jajaran tim internal sekolah.</span>
              </div>
            </li>
            <li>
              <span class="fasilitas-check">✓</span>
              <div>
                <strong>Lembar Kerja Roadmap Sekolah</strong>
                <span>Worksheet 5 halaman terstruktur untuk diisi selama sesi &amp; jadi action plan Anda.</span>
              </div>
            </li>
            <li>
              <span class="fasilitas-check">✓</span>
              <div>
                <strong>E-Sertifikat Resmi Jagatrip</strong>
                <span>Sertifikat digital resmi yang bisa Anda gunakan sebagai bukti reimburse ke sekolah/yayasan.</span>
              </div>
            </li>
            <li>
              <span class="fasilitas-check">✓</span>
              <div>
                <strong>Grup Diskusi Alumni</strong>
                <span>Networking strategis dengan kepala sekolah &amp; founder swasta dari seluruh Indonesia.</span>
              </div>
            </li>
            <li>
              <span class="fasilitas-check">✓</span>
              <div>
                <strong>Sesi Q&amp;A Prioritas</strong>
                <span>Kesempatan konsultasi dan bertanya langsung ke Pak Dedi via Raise Hand.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ SPEAKER ============ -->
    <section class="speaker-section" id="pemateri">
      <div class="container speaker-inner">
        <div class="speaker-photo-wrap">
          <img 
            src="/images/owner/owner.jpeg" 
            alt="Muhammad Dedi Gunawan — Founder Jagatrip & 6 Sekolah IDN" 
            width="320" 
            height="320" 
            class="speaker-avatar-img"
            loading="lazy"
          />
        </div>

        <div class="speaker-content">
          <div class="speaker-pill">PEMATERI</div>
          <h2>Muhammad Dedi Gunawan</h2>
          <div class="role">Founder Jagatrip &amp; 6 Sekolah IDN</div>
          
          <ul class="speaker-credentials">
            <li>Founder IDN Boarding School</li>
            <li>Owner Annaba Bilingual School</li>
            <li>Owner Ma'had Tahfidz IDN &amp; Politeknik IDN</li>
            <li>Owner IDN Mecca-Madina School (literal international presence)</li>
            <li>Founder IDN Backpacker School</li>
            <li>Backpacker 30+ negara — praktisi pendidikan, bukan konsultan</li>
          </ul>

          <div class="speaker-quote">
            "Saya sudah menghadapi setiap pertanyaan yang Anda hadapi sekarang. Yang saya bagi bukan teori — ini yang bekerja."
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FORMAT SESI ============ -->
    <section class="format-section">
      <div class="container">
        <div class="format-header">
          <span class="eyebrow">Alur Sesi</span>
          <h2 class="section-title">Bukan Webinar <em>Pasif.</em></h2>
          <p class="section-lead">Anda tidak sekadar menonton — Anda akan pulang membawa lembar kerja yang sudah terisi &amp; roadmap yang siap dipresentasikan ke yayasan.</p>
        </div>

        <div class="format-flow">
          <div class="flow-step">
            <div class="flow-num">1</div>
            <h4>Opening</h4>
            <p>Framing masalah industri &amp; penetapan objektif sesi.</p>
          </div>
          <div class="flow-step">
            <div class="flow-num">2</div>
            <h4>Pemaparan</h4>
            <p>4 fase roadmap program internasional dibahas tuntas oleh Pak Dedi.</p>
          </div>
          <div class="flow-step">
            <div class="flow-num">3</div>
            <h4>Isi Lembar Kerja</h4>
            <p>Sesi terpandu — Anda susun action plan sekolah Anda sendiri.</p>
          </div>
          <div class="flow-step">
            <div class="flow-num">4</div>
            <h4>Q&amp;A</h4>
            <p>Sesi tanya jawab prioritas langsung via Raise Hand.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PRICING ============ -->
    <section class="pricing-section" id="pricing">
      <div class="container">
        <div class="pricing-header">
          <span class="eyebrow">Pilih Tier Anda</span>
          <h2 class="section-title">Dua Opsi. Pilih Sesuai <em>Ambisi</em> Sekolah Anda.</h2>
          <p class="section-lead">Regular untuk yang butuh dasar roadmap. Premium untuk yang siap satu langkah lebih jauh — bertemu langsung dengan PIC kampus mitra di Malaysia.</p>
        </div>

        <div class="pricing-grid">

          <!-- REGULAR -->
          <div class="tier-card">
            <div class="tier-name">Regular</div>
            <div class="tier-tagline">Untuk kepala sekolah yang butuh kerangka roadmap.</div>
            <div class="tier-price-row">
              <div class="tier-price"><span class="rp">Rp</span>99.000</div>
            </div>
            <div class="tier-slot">Kuota Terbatas</div>
            <ul class="tier-features">
              <li>Live webinar full session bersama Pak Dedi</li>
              <li>Rekaman webinar (akses 3 bulan)</li>
              <li>Lembar Kerja Roadmap Sekolah</li>
              <li>E-sertifikat resmi Jagatrip</li>
              <li>Akses grup diskusi alumni Jagatalk</li>
            </ul>
            <a href="#form" class="tier-cta regular">Pilih Regular</a>
          </div>

          <!-- PREMIUM -->
          <div class="tier-card premium">
            <div class="tier-name">Premium</div>
            <div class="tier-tagline">Untuk kepala sekolah yang siap satu langkah lebih jauh.</div>
            <div class="tier-price-row">
              <div class="tier-price"><span class="rp">Rp</span>129.000</div>
            </div>
            <div class="tier-slot">Slot Sangat Terbatas · Maks. 30 Kursi</div>
            <ul class="tier-features">
              <li>Semua benefit yang ada pada tier Regular</li>
              <li class="highlight">
                <strong>Prioritas Undangan Exclusive Meet-Up</strong> dengan PIC 2 Kampus Mitra Jagatrip di Malaysia:
                <br>• IIUM (Int'l Islamic University Malaysia)
                <br>• TAR UMT (Univ. of Management &amp; Technology)
              </li>
              <li>Prioritas info Pilot Summer Camp 2027 di kampus mitra</li>
            </ul>
            <a href="#form" class="tier-cta premium-btn">Pilih Premium →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- ============ URGENCY BANNER ============ -->
    <section class="urgency-banner-section">
      <div class="container">
        <div class="urgency-content">
          <div class="urgency-icon">⏱</div>
          <div class="urgency-text">
            <h3>Kuota Premium Cepat Habis — Slot Terbatas 30 Kursi</h3>
            <p>Setiap batch tidak dibuka lebih dari sekali. Menunggu tahun depan berarti menunda satu tahun perubahan sekolah Anda.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FORM SECTION ============ -->
    <section class="form-section" id="form">
      <div class="container">
        <h2>Amankan Kursi Anda <em>Sekarang.</em></h2>
        <p class="lead">Isi form di bawah — setelah submit Anda akan langsung diarahkan ke WhatsApp Admin resmi kami untuk konfirmasi tier &amp; pembayaran.</p>
        
        <div class="form-card">
          <h3>Form Pendaftaran</h3>
          <p class="form-lead">Cukup 3 kolom. Waktu Anda berharga.</p>
          
          <form id="registration-form" novalidate>
            <div class="form-group">
              <label for="nama_lengkap">Nama Lengkap *</label>
              <input 
                type="text" 
                id="nama_lengkap" 
                name="nama_lengkap" 
                required 
                placeholder="Nama sesuai identitas" 
                autocomplete="name"
              />
              <span class="field-error" id="error-nama"></span>
            </div>

            <div class="form-group">
              <label for="asal_lembaga">Asal Lembaga / Domisili *</label>
              <input 
                type="text" 
                id="asal_lembaga" 
                name="asal_lembaga" 
                required 
                placeholder="Contoh: SMP Al-Hikmah Jakarta" 
                autocomplete="organization"
              />
              <span class="field-error" id="error-lembaga"></span>
            </div>

            <div class="form-group">
              <label for="nomor_wa">Nomor WhatsApp Aktif *</label>
              <input 
                type="tel" 
                id="nomor_wa" 
                name="nomor_wa" 
                required 
                placeholder="08xxxxxxxxxx" 
                autocomplete="tel"
              />
              <span class="field-error" id="error-wa"></span>
            </div>

            <button type="submit" id="btn-submit" class="form-submit">
              Daftar &amp; Amankan Kursi →
            </button>

            <p class="form-footer">
              Setelah submit, admin kami (Admin Dwita) akan langsung menerima data Anda untuk konfirmasi tier &amp; pembayaran.
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- ============ FAQ SECTION ============ -->
    <section class="faq-section" id="faq">
      <div class="container">
        <div class="faq-header">
          <span class="eyebrow">Pertanyaan Umum</span>
          <h2 class="section-title">Yang <em>Sering Ditanyakan.</em></h2>
        </div>

        <div class="faq-list">
          <details class="faq-item">
            <summary>Saya bukan kepala sekolah — apakah tetap boleh ikut?</summary>
            <p>Boleh. Sesi ini terbuka untuk siapapun yang punya peran strategis di sekolah swasta: founder, direktur, ketua yayasan, wakil kepala sekolah, atau guru senior yang sedang dipersiapkan untuk peran leadership.</p>
          </details>

          <details class="faq-item">
            <summary>Sekolah saya belum akreditasi A. Apakah masih relevan mengikuti sesi ini?</summary>
            <p>Sangat relevan. Sesi ini justru cocok untuk sekolah di berbagai tahap kesiapan. Kalau akreditasi masih B atau C, sesi ini akan membantu Anda melihat prioritas &amp; urutan yang tepat untuk naik ke akreditasi A sebagai prasyarat naik kelas.</p>
          </details>

          <details class="faq-item">
            <summary>Apa bedanya tier Regular dan Premium?</summary>
            <p>Tier Regular memberikan akses penuh ke webinar, semua materi, rekaman, worksheet, dan sertifikat. Tier Premium menambahkan <strong>Prioritas Undangan ke Exclusive Meet-Up dengan PIC 2 Kampus Mitra Jagatrip di Malaysia</strong> (IIUM &amp; TAR UMT) — sesi terpisah yang dijadwalkan beberapa minggu setelah webinar utama.</p>
          </details>

          <details class="faq-item">
            <summary>Apakah Meet-Up dengan kampus Malaysia langsung menghasilkan MoU?</summary>
            <p>Tidak — Meet-Up adalah sesi <em>awareness &amp; introduction</em>. Anda mendapatkan akses bertanya langsung ke PIC kampus tentang program &amp; kriteria kolaborasi. Kalau tertarik melanjutkan ke partnership formal, tahap berikutnya (due diligence &amp; MoU) dapat difasilitasi Jagatrip sesuai kebutuhan.</p>
          </details>

          <details class="faq-item">
            <summary>Kapan Exclusive Meet-Up dilaksanakan?</summary>
            <p>Meet-Up dijadwalkan beberapa minggu setelah Jagatalk #8. Tanggal final akan diinformasikan maksimal 7 hari setelah webinar utama. Peserta Premium mendapat notifikasi via email &amp; WhatsApp.</p>
          </details>

          <details class="faq-item">
            <summary>Bagaimana kalau saya berhalangan hadir di hari-H?</summary>
            <p>Tidak masalah. Rekaman lengkap akan dikirim ke email Anda maksimal 3 hari setelah acara. Anda tetap bisa menonton di waktu senggang.</p>
          </details>

          <details class="faq-item">
            <summary>Bisa reimburse ke sekolah atau yayasan?</summary>
            <p>Ya. E-sertifikat resmi Jagatrip yang Anda terima bisa dijadikan bukti untuk reimburse biaya ke institusi Anda (sesuai policy masing-masing).</p>
          </details>

          <details class="faq-item">
            <summary>Bagaimana metode pembayaran?</summary>
            <p>Setelah Anda submit form, admin kami akan menghubungi Anda via WhatsApp untuk konfirmasi tier &amp; instruksi pembayaran. Kami menerima transfer bank, e-wallet, dan virtual account.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="site-footer">
      <div class="container">
        <div class="tagline">Travel to Learn, Learn to Lead.</div>
        <div class="divider"></div>
        <div class="copyright">© 2026 Jagatrip · JAGATALK #8 · Semua hak dilindungi.</div>
        <div class="socials">jagatrip.com &nbsp;·&nbsp; IG: @jagatrip.id &nbsp;·&nbsp; TikTok: @jagatrip</div>
      </div>
    </footer>

  </main>
</BaseLayout>

<!-- Client Script for Form Validation, Google Sheets Webhook, WhatsApp Redirect, and Flyer Modal -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Helper function to extract UTM parameters
    function getUtmParams() {
      const params = new URLSearchParams(window.location.search);
      return {
        utm_source: params.get('utm_source') || '',
        utm_medium: params.get('utm_medium') || '',
        utm_campaign: params.get('utm_campaign') || '',
        utm_term: params.get('utm_term') || '',
        utm_content: params.get('utm_content') || '',
        gclid: params.get('gclid') || '',
        fbclid: params.get('fbclid') || ''
      };
    }

    // Helper function to normalize & format Indonesian phone number
    function formatPhone(raw) {
      if (!raw) return { sheetWa: '', waNumber: '', digits: '' };
      
      // Strip everything except digits
      let digits = raw.toString().replace(/[^0-9]/g, '');
      
      // Standardize to E.164 (628...)
      let e164 = '';
      if (digits.startsWith('0')) {
        e164 = '62' + digits.slice(1);
      } else if (digits.startsWith('6208')) {
        e164 = '62' + digits.slice(3);
      } else if (digits.startsWith('62')) {
        e164 = digits;
      } else if (digits.startsWith('8')) {
        e164 = '62' + digits;
      } else {
        e164 = '62' + digits;
      }

      // Convert to clean standard 08... format for Sheet display
      const localPhone = '0' + e164.slice(2);
      
      // Prefix with single quote so Google Sheets treats it as pure string: '083178772170
      const sheetWa = "'" + localPhone;

      return {
        sheetWa: sheetWa,
        waNumber: e164,
        digits: localPhone
      };
    }

    // 1. Form Validation & Webhook Submission & WhatsApp Redirect
    const form = document.getElementById('registration-form');
    if (form) {
      const namaInput = document.getElementById('nama_lengkap');
      const lembagaInput = document.getElementById('asal_lembaga');
      const waInput = document.getElementById('nomor_wa');
      const submitBtn = document.getElementById('btn-submit');

      const errNama = document.getElementById('error-nama');
      const errLembaga = document.getElementById('error-lembaga');
      const errWa = document.getElementById('error-wa');

      // Realtime sanitization on phone input
      if (waInput) {
        waInput.addEventListener('input', (e) => {
          // Allow digits, +, -, and spaces while typing, but auto-clean on paste
          const cleaned = e.target.value.replace(/[^0-9+\-\s]/g, '');
          if (cleaned !== e.target.value) {
            e.target.value = cleaned;
          }
        });
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        let isValid = true;
        if (errNama) errNama.textContent = '';
        if (errLembaga) errLembaga.textContent = '';
        if (errWa) errWa.textContent = '';

        const nama = namaInput ? namaInput.value.trim() : '';
        const lembaga = lembagaInput ? lembagaInput.value.trim() : '';
        const rawWa = waInput ? waInput.value.trim() : '';
        const phone = formatPhone(rawWa);

        if (!nama) {
          if (errNama) errNama.textContent = 'Nama lengkap wajib diisi.';
          isValid = false;
        }

        if (!lembaga) {
          if (errLembaga) errLembaga.textContent = 'Asal lembaga/domisili wajib diisi.';
          isValid = false;
        }

        if (!rawWa) {
          if (errWa) errWa.textContent = 'Nomor WhatsApp wajib diisi.';
          isValid = false;
        } else if (phone.digits.length < 9 || phone.digits.length > 15) {
          if (errWa) errWa.textContent = 'Format nomor WhatsApp tidak valid (contoh: 081234567890).';
          isValid = false;
        }

        if (!isValid) return;

        // Visual feedback
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Mengarahkan ke WhatsApp...';
        }

        // WhatsApp Admin Dwita & Greeting
        const adminWa = '6281128506576';
        const greetingMessage = `Halo Admin, saya ${nama} ingin mengikuti Webinar Jagatalk Roadmap Sekolah dan sudah mengisi form. Bagaimana selanjutnya?`;
        const waUrl = `https://wa.me/${adminWa}?text=${encodeURIComponent(greetingMessage)}`;

        // Send Lead to Google Apps Script Webhook (Fire-and-forget with keepalive)
        const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwrwCUYnuIUCflczefMlYAHdCnOD-5PMqVEL94QTPWy6Hkds6SiOQLfyo7PZpVoqtjiZg/exec';

        try {
          fetch(APPS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            keepalive: true,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              _sheet: 'LP_Jagatalk8',
              nama: nama,
              institusi: lembaga,
              instansi: lembaga,
              asal_lembaga: lembaga,
              wa: phone.sheetWa, // Stored as pure string with ' prefix (e.g. '083178772170)
              source: 'JAGATALK #8 Landing Page (/jagatalk8)',
              timestamp: new Date().toISOString(),
              ...getUtmParams()
            })
          }).catch((err) => console.error('Webhook error:', err));
        } catch (err) {
          console.error('Fetch error:', err);
        }

        // Trigger Meta/Facebook Pixel Lead event if present
        if (window.fbq) {
          try {
            window.fbq('track', 'Lead');
          } catch (e) {
            console.error('FB Pixel error:', e);
          }
        }

        // Trigger Google Tag Manager dataLayer event
        if (window.dataLayer) {
          try {
            window.dataLayer.push({
              event: 'lead_form_submit',
              form_name: 'jagatalk8',
              user_name: nama,
              user_instansi: lembaga
            });
          } catch (e) {
            console.error('GTM error:', e);
          }
        }

        // Instant redirect to WhatsApp
        setTimeout(() => {
          window.location.href = waUrl;
        }, 300);
      });
    }

    // 2. Flyer Lightbox Modal Toggle
    const openBtn = document.getElementById('open-flyer-btn');
    const modal = document.getElementById('flyer-modal');
    const closeBtn = document.getElementById('close-modal-btn');
    const backdrop = document.getElementById('close-modal-backdrop');

    function openModal() {
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeModal();
      }
    });
  });
</script>

