<script>
  import { getUtm } from '../lib/utm';
  import { initFormGuard, lockForm } from '../lib/form-guard';
  import { parseIndonesianPhone, formatPhoneInputRealtime } from '../lib/phone-formatter';

  const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwrwCUYnuIUCflczefMlYAHdCnOD-5PMqVEL94QTPWy6Hkds6SiOQLfyo7PZpVoqtjiZg/exec';
  const WA_ADMIN = '628139190363'; // Admin Kamariya

  document.addEventListener('DOMContentLoaded', () => {
    // Reveal on scroll
    const els = document.querySelectorAll('.rv');
    if (!('IntersectionObserver' in window)) {
      els.forEach((e) => e.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (en) => en.forEach((x) => {
          if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); }
        }),
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );
      els.forEach((e) => io.observe(e));
    }

    const form = document.getElementById('regForm') as HTMLFormElement | null;
    if (!form) return;
    initFormGuard(form, 'batch2-form', '✓ Minat Anda sudah terkirim. Tim program akan menghubungi Anda.');

    // Auto-format nomor WA saat diketik
    const waInput = form.querySelector<HTMLInputElement>('#whatsapp');
    waInput?.addEventListener('input', () => {
      waInput.value = formatPhoneInputRealtime(waInput.value);
    });

    const bad = (id: string, v: boolean) =>
      document.getElementById(id)?.classList.toggle('bad', v);

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();

      const nama = (form.querySelector('#nama') as HTMLInputElement)?.value.trim() ?? '';
      const institusi = (form.querySelector('#institusi') as HTMLInputElement)?.value.trim() ?? '';
      const rawWa = (form.querySelector('#whatsapp') as HTMLInputElement)?.value.trim() ?? '';

      const parsed = parseIndonesianPhone(rawWa);
      const e1 = nama.length < 3, e2 = institusi.length < 3, e3 = !parsed.isValid;
      bad('f1', e1); bad('f2', e2); bad('f3', e3);
      if (e1 || e2 || e3) {
        form.querySelector<HTMLInputElement>('.fld.bad input')?.focus();
        return;
      }

      const wa = parsed.e164;
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Mengirim...'; }

      try {
        await fetch(APPS_SCRIPT_URL, {
          method: 'POST', mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _sheet: 'Batch2', nama, institusi, wa,
            ...getUtm(), source: 'LP /batch2', timestamp: new Date().toISOString(),
          }),
        });
      } catch (err) { console.error('Log lead error:', err); }

      const win = window as any;
      if (win.fbq) { try { win.fbq('track', 'Lead', { content_name: 'Batch2 Oktober' }); } catch (e) { console.error(e); } }

      lockForm(form, 'batch2-form');

      const greeting = `Halo Admin, saya ${nama} tertarik ikut Jagatrip Oktober Malay - Thailand, dan sudah mengisi form. Bagaimana selanjutnya?`;
      const waUrl = `https://wa.me/${WA_ADMIN}?text=${encodeURIComponent(greeting)}`;

      const formArea = document.getElementById('formArea');
      const okArea = document.getElementById('okArea');
      if (formArea) formArea.style.display = 'none';
      if (okArea) okArea.style.display = 'block';

      setTimeout(() => { window.location.href = waUrl; }, 600);
    });

    ['nama', 'institusi', 'whatsapp'].forEach((id) => {
      form.querySelector<HTMLInputElement>('#' + id)?.addEventListener('input', function (this: HTMLInputElement) {
        this.closest('.fld')?.classList.remove('bad');
      });
    });
  });
</script>

